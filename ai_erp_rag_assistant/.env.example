AI_ERP_RAG_HOST=127.0.0.1
AI_ERP_RAG_PORT=8021

# Existing Milvus Standalone container
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=erp_knowledge_chunks
MILVUS_DIMENSION=2048

# Local knowledge assets
RAG_SOURCE_DIR=data/knowledge/source
RAG_PROCESSED_DIR=data/knowledge/processed
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_SCORE=0.35
RAG_COMPANY_ID=lanjing
RAG_DEPARTMENT=公共制度
RAG_PERMISSION_TAGS=knowledge:employee_handbook

# Remote calls use the dev2 ERP environment; set mock only for an explicitly
# labelled offline rehearsal.
ERP_MODE=remote
# Read real ERP templates in remote mode; keep writes disabled for demos.
ERP_READ_MODE=remote
ERP_WRITE_MODE=disabled
# Validate the request Authorization against ERP /userinfo.
ERP_SKIP_USERINFO_VALIDATION=false
ERP_BASE_URL=https://dev2.lanerp.com
ERP_UID=
ERP_AUTHORIZATION=
ERP_DEMO_COMPANY_ID=
ERP_DEMO_DEPARTMENT=
ERP_APPROVAL_STATUS_PATH=/api/approval/myList
ERP_HOLIDAY_RULE_PATH=/api/attendance/getHolidayRuleByUser
ERP_CALCULATE_HOLIDAY_DURATION_PATH=/api/attendance/calculateHolidayDuration

# LLM planner/answer model. These can be inherited from repository .env.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=60

# Required only when generating Dense embeddings
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=2048

PYTHONUTF8=1
PYTHONIOENCODING=utf-8
