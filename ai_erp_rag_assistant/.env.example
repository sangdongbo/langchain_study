AI_ERP_RAG_HOST=127.0.0.1
AI_ERP_RAG_PORT=8021

# Long-term session store. Keep memory until the reviewed SQL has been applied.
AI_ERP_SESSION_STORE=memory
AI_ERP_ASSISTANT_KEY=erp-rag
AI_ERP_MYSQL_HOST=127.0.0.1
AI_ERP_MYSQL_PORT=3306
AI_ERP_MYSQL_DATABASE=
AI_ERP_MYSQL_USER=
AI_ERP_MYSQL_PASSWORD=
AI_ERP_MYSQL_CONNECT_TIMEOUT=5
AI_ERP_AUDIT_LOG_PATH=logs/ai_erp_audit.jsonl

# Existing Milvus Standalone container
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=erp_knowledge_chunks
MILVUS_DIMENSION=2048

# Local knowledge assets
RAG_SOURCE_DIR=data/knowledge/source
RAG_PROCESSED_DIR=data/knowledge/processed
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_SCORE=0.35
RAG_COMPANY_ID=lanjing
RAG_DEPARTMENT=公共制度
RAG_PERMISSION_TAGS=knowledge:employee_handbook

# Remote calls use the dev2 ERP environment; set mock only for an explicitly
# labelled offline rehearsal.
ERP_MODE=remote
# Read real ERP templates in remote mode; keep writes disabled for demos.
ERP_READ_MODE=remote
ERP_WRITE_MODE=disabled
# Validate the request Authorization against ERP /userinfo.
ERP_SKIP_USERINFO_VALIDATION=false
ERP_BASE_URL=https://dev2.lanerp.com
# Compatibility alias used by ai_approval_assistant; ERP_BASE_URL takes precedence.
AI_APPROVAL_CRM_BASE_URL=
ERP_UID=
ERP_AUTHORIZATION=
ERP_DEMO_COMPANY_ID=
ERP_DEMO_DEPARTMENT=
# ERP API paths; override these only when the ERP deployment uses different routes.
ERP_APPROVAL_LIST_PATH=/api/approval/list
ERP_FORM_FIELDS_PATH=/api/field/formFields
ERP_GET_NODES_PATH=/api/approval/getNodes
ERP_ADD_APPROVAL_PATH=/api/approval/add
ERP_APPROVAL_STATUS_PATH=/api/approval/myList
ERP_RELATED_LIST_PATH=/api/Company/getRelatedList
ERP_HOLIDAY_RULE_PATH=/api/attendance/getHolidayRuleByUser
ERP_CALCULATE_HOLIDAY_DURATION_PATH=/api/attendance/calculateHolidayDuration
ERP_USER_LIST_PATH=/api/User/getList
ERP_USERINFO_PATH=/api/User/userinfo

# LLM planner/answer model. These can be inherited from repository .env.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=60

# DashScope OpenAI-compatible settings (used when LLM_* values are blank).
# If EMBEDDING_BASE_URL is blank, DASHSCOPE_BASE_URL is reused for embeddings.
DASHSCOPE_API_KEY=
DASHSCOPE_OPENAI_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=2048

# DeepSeek fallback settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Optional OpenAI-compatible fallback credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
TAVILY_API_KEY=

# LangSmith tracing (opt in for joint debugging)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-erp-rag-assistant

# Required only when generating Dense embeddings
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=2048

PYTHONUTF8=1
PYTHONIOENCODING=utf-8
