# Model: use the generic LLM_* variables, or the DeepSeek fallback below.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT=120

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# LangSmith tracing. Traces appear under LANGSMITH_PROJECT.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-agent-examples

# The local Agent Protocol server started by `langgraph dev`.
# async_subagent_agent calls remote_research_agent through this URL.
AGENT_SERVER_URL=http://127.0.0.1:2024
AGENT_SERVER_TOKEN=

# Optional LangSmith cloud sandbox. Leave blank to use the account default.
LANGSMITH_SANDBOX_SNAPSHOT=

# Optional OpenSandbox example (runs in a separate legacy environment).
OPENSANDBOX_URL=localhost:8080
OPENSANDBOX_API_KEY=
OPENSANDBOX_IMAGE=python:3.11-slim

# Required on Windows when the system locale is not UTF-8. It also keeps
# Chinese tool results readable in the LangGraph API subprocess.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
